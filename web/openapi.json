  "components": {
    "schemas": {
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "JobRequest": {
        "properties": {
          "name": {
            "type": "string",
            "title": "Name",
            "examples": [
              "echo"
            ]
          },
          "args": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Args"
          }
        },
        "type": "object",
        "required": [
          "name"
        ],
        "title": "JobRequest"
      },
      "SequenceRequest": {
        "properties": {
          "agent_id": {
            "type": "string",
            "title": "Agent Id"
          },
          "sensor_id": {
            "type": "string",
            "title": "Sensor Id"
          },
          "start_us": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Start Us"
          },
          "end_us": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "End Us"
          },
          "fps": {
            "type": "integer",
            "title": "Fps",
            "default": 10
          },
          "width": {
            "type": "integer",
            "title": "Width",
            "default": 0
          },
          "height": {
            "type": "integer",
            "title": "Height",
            "default": 0
          },
          "format": {
            "type": "string",
            "title": "Format"
          }
        },
        "type": "object",
        "required": [
          "agent_id",
          "sensor_id",
          "format"
        ],
        "title": "SequenceRequest"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      },
      "ViewSequenceRequest": {
        "properties": {
          "format": {
            "type": "string",
            "title": "Format"
          },
          "fps": {
            "type": "integer",
            "title": "Fps"
          },
          "start_us": {
            "type": "integer",
            "title": "Start Us"
          },
          "end_us": {
            "type": "integer",
            "title": "End Us"
          },
          "frames_b64": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Frames B64"
          }
        },
        "type": "object",
        "required": [
          "format",
          "fps",
          "start_us",
          "end_us"
        ],
        "title": "ViewSequenceRequest"
      }
    }
  }
