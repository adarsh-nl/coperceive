from typing import Any

class Image:
    size: tuple[int, int]
    format: str | None

    def convert(self, mode: str) -> Image: ...
    def thumbnail(self, size: tuple[int, int], resample: int) -> None: ...
    def save(self, fp: Any, format: str | None = ..., quality: int = ...) -> None: ...
    def close(self) -> None: ...
    def __enter__(self) -> Image: ...
    def __exit__(self, *args: object) -> None: ...

class Resampling:
    LANCZOS: int

def open(path: Any) -> Image: ...
def new(mode: str, size: tuple[int, int], color: tuple[int, int, int] = ...) -> Image: ...
