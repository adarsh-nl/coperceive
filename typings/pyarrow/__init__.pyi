from collections.abc import Mapping, Sequence
from typing import Any

class DataType: ...

def string() -> DataType: ...
def int64() -> DataType: ...
def float32() -> DataType: ...
def float64() -> DataType: ...
def array(values: Sequence[Any], type: DataType | None = None) -> Array: ...
def nulls(size: int, type: DataType | None = None) -> Array: ...
def table(columns: Mapping[str, Array]) -> Table: ...

class Array: ...

class Table:
    num_rows: int

    @staticmethod
    def from_pylist(rows: Sequence[Mapping[str, Any]]) -> Table: ...
    def to_pylist(self) -> list[dict[str, Any]]: ...
    def append_column(self, field: str, column: Array) -> Table: ...
