from collections.abc import Mapping, Sequence
from typing import Any

class DataType: ...

def string() -> DataType: ...
def int64() -> DataType: ...
def float32() -> DataType: ...
def float64() -> DataType: ...
def array(values: Sequence[Any], type: DataType | None = None) -> Array: ...
def nulls(size: int, type: DataType | None = None) -> Array: ...
def table(columns: Mapping[str, Array]) -> Table: ...
def field(name: str, type: DataType, nullable: bool = ...) -> Field: ...
def schema(fields: Sequence[Field]) -> Schema: ...

class Array: ...

class Field:
    name: str
    type: DataType
    nullable: bool

class Schema:
    names: list[str]

    def empty_table(self) -> Table: ...
    def field(self, name: str) -> Field: ...

class Table:
    num_rows: int
    schema: Schema

    @staticmethod
    def from_pylist(rows: Sequence[Mapping[str, Any]], schema: Schema | None = None) -> Table: ...
    def to_pylist(self) -> list[dict[str, Any]]: ...
    def append_column(self, field: str, column: Array) -> Table: ...
