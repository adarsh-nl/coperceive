{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Coperceive",
  "version": "0.0.0",
  "identifier": "nl.adarsh.coperceive",
  "build": {
    "beforeDevCommand": "npm run build --prefix ../web",
    "beforeBuildCommand": "npm run build --prefix ../web",
    "frontendDist": "../coperceive/app/static"
  },
  "app": {
    "windows": [
      {
        "title": "Coperceive",
        "width": 1280,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null,
      "capabilities": ["default"]
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "resources": ["resources/**/*"],
    "macOS": {
      "frameworks": [],
      "minimumSystemVersion": "13.0"
    }
  },
  "plugins": {
    "dialog": {}
  }
}
