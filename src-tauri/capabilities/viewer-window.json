{
  "$schema": "https://schema.tauri.app/config/2/capability",
  "identifier": "viewer-window",
  "description": "The viewer window (a page served on 127.0.0.1) may only move and zoom its own window from the unified toolbar.",
  "windows": [
    "viewer"
  ],
  "remote": {
    "urls": [
      "http://127.0.0.1:*"
    ]
  },
  "permissions": [
    "core:window:allow-start-dragging",
    "core:window:allow-internal-toggle-maximize"
  ]
}
