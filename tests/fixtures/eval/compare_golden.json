  "thresholds": [
    0.5,
    0.7
  ],
  "distance_edges_m": [
    0.0,
    30.0,
    50.0
  ],
  "visibility_edges": [
    0.2,
    0.6
  ],
  "breakdowns": [
    "distance",
    "occlusion",
    "agents",
    "class",
    "scene"
  ],
  "distance_source": "scene",
  "definitions": {
    "distance": "Horizontal metres from the reference agent (the first agent in the scene) to the box centre at that box's time. The reference agent is the one CooperativeDataset uses when no agent list is passed.",
    "occlusion": "From the ground-truth visibility fraction. Null visibility is unknown. The default edges 0.2 and 0.6 name heavy, partial and clear. A value outside [0, 1] keeps its own visibility:<value> label.",
    "agents": "How many agents annotate the object at that time, including the annotating agent. Pairing is the cooperative gate (shared track, or a computed pair within 2 m). 2+ means the match table only recorded that another agent sees it.",
    "reference_agent": "The first agent in scene.agents."
  },
